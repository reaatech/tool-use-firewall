{
  "name": "@reaatech/tool-use-firewall-config",
  "version": "0.2.0",
  "description": "Policy configuration schema and loader for tool-use-firewall",
  "license": "MIT",
  "author": "Rick Somers <rick@reaatech.com> (https://reaatech.com)",
  "repository": {
    "type": "git",
    "url": "https://github.com/reaatech/tool-use-firewall.git",
    "directory": "packages/config"
  },
  "homepage": "https://github.com/reaatech/tool-use-firewall/tree/main/packages/config#readme",
  "bugs": {
    "url": "https://github.com/reaatech/tool-use-firewall/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "mcp",
    "firewall",
    "security",
    "ai",
    "proxy",
    "policy",
    "config",
    "yaml",
    "zod"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@reaatech/tool-use-firewall-core": "workspace:*",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.7"
  }
}
