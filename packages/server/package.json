{
  "name": "@reaatech/tool-use-firewall-server",
  "version": "0.2.0",
  "description": "MCP proxy server, CLI, and main entry point for tool-use-firewall",
  "license": "MIT",
  "author": "Rick Somers <rick@reaatech.com> (https://reaatech.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reaatech/tool-use-firewall.git",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/reaatech/tool-use-firewall/tree/main/packages/server#readme",
  "bugs": {
    "url": "https://github.com/reaatech/tool-use-firewall/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "tool-use-firewall": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./cli": {
      "import": {
        "types": "./dist/cli.d.ts",
        "default": "./dist/cli.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "mcp",
    "firewall",
    "security",
    "ai",
    "proxy",
    "cli",
    "mcp-server",
    "policy-enforcement"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@reaatech/tool-use-firewall-core": "workspace:*",
    "@reaatech/tool-use-firewall-config": "workspace:*",
    "@reaatech/tool-use-firewall-policies": "workspace:*",
    "@reaatech/tool-use-firewall-approvals": "workspace:*",
    "@reaatech/tool-use-firewall-audit": "workspace:*",
    "express": "^5.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "@types/express": "^5.0.6",
    "@types/supertest": "^7.2.0",
    "express": "^5.2.1",
    "supertest": "^7.2.2",
    "tsup": "^8.4.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
