{
  "name": "@reaatech/tool-use-firewall-approvals",
  "version": "0.1.0",
  "description": "Human-in-the-loop approval workflow for tool-use-firewall",
  "license": "MIT",
  "author": "Rick Somers <rick@reaatech.com> (https://reaatech.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reaatech/tool-use-firewall.git",
    "directory": "packages/approvals"
  },
  "homepage": "https://github.com/reaatech/tool-use-firewall/tree/main/packages/approvals#readme",
  "bugs": {
    "url": "https://github.com/reaatech/tool-use-firewall/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "mcp",
    "firewall",
    "security",
    "ai",
    "proxy",
    "approval",
    "human-in-the-loop",
    "webhook"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@reaatech/tool-use-firewall-core": "workspace:*",
    "@reaatech/tool-use-firewall-config": "workspace:*",
    "@reaatech/tool-use-firewall-policies": "workspace:*",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "express": "^5.0.0 || ^4.18.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.8.0",
    "express": "^5.2.1",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.7"
  }
}
