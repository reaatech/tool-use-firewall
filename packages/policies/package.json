{
  "name": "@reaatech/tool-use-firewall-policies",
  "version": "0.1.0",
  "description": "Policy engine, rate limiting, cost tracking, and argument validation for tool-use-firewall",
  "license": "MIT",
  "author": "Rick Somers <rick@reaatech.com> (https://reaatech.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reaatech/tool-use-firewall.git",
    "directory": "packages/policies"
  },
  "homepage": "https://github.com/reaatech/tool-use-firewall/tree/main/packages/policies#readme",
  "bugs": {
    "url": "https://github.com/reaatech/tool-use-firewall/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "mcp",
    "firewall",
    "security",
    "ai",
    "proxy",
    "policy",
    "rate-limiting",
    "cost-tracking",
    "sql-validation"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@reaatech/tool-use-firewall-core": "workspace:*",
    "@reaatech/tool-use-firewall-config": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "tsup": "^8.4.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
