{
  "name": "tool-use-firewall",
  "version": "0.1.0",
  "description": "Policy enforcement layer between AI agents and MCP servers — the `tool-use-firewall` CLI and a re-export of the full API",
  "license": "MIT",
  "author": "Rick Somers <rick@reaatech.com> (https://reaatech.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reaatech/tool-use-firewall.git",
    "directory": "packages/meta"
  },
  "homepage": "https://github.com/reaatech/tool-use-firewall#readme",
  "bugs": {
    "url": "https://github.com/reaatech/tool-use-firewall/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "tool-use-firewall": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "mcp",
    "firewall",
    "ai-agent",
    "policy",
    "security",
    "proxy",
    "cli"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@reaatech/tool-use-firewall-server": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "tsup": "^8.4.0",
    "typescript": "^6.0.3"
  }
}
