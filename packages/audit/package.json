{
  "name": "@reaatech/tool-use-firewall-audit",
  "version": "0.1.0",
  "description": "Audit logging with redaction for tool-use-firewall",
  "license": "MIT",
  "author": "Rick Somers <rick@reaatech.com> (https://reaatech.com)",
  "repository": {
    "type": "git",
    "url": "https://github.com/reaatech/tool-use-firewall.git",
    "directory": "packages/audit"
  },
  "homepage": "https://github.com/reaatech/tool-use-firewall/tree/main/packages/audit#readme",
  "bugs": { "url": "https://github.com/reaatech/tool-use-firewall/issues" },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@reaatech/tool-use-firewall-core": "workspace:*",
    "@reaatech/tool-use-firewall-config": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1"
  }
}
