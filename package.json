{
  "name": "tool-use-firewall",
  "version": "0.1.0",
  "description": "Policy enforcement layer between AI agents and MCP servers",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "tool-use-firewall": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/ tests/",
    "lint:fix": "eslint src/ tests/ --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "security:audit": "pnpm audit --audit-level high",
    "prepare": "husky",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "keywords": [
    "mcp",
    "firewall",
    "ai-agent",
    "policy",
    "security",
    "proxy"
  ],
  "author": "Rick Somers <rick@reaatech.com> (https://reaatech.com)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reaatech/tool-use-firewall.git"
  },
  "bugs": {
    "url": "https://github.com/reaatech/tool-use-firewall/issues"
  },
  "homepage": "https://github.com/reaatech/tool-use-firewall#readme",
  "files": [
    "dist/",
    "policies/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "dependencies": {
    "express": "^5.2.1",
    "yaml": "^2.7.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.2",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^3.1.2",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-security": "^4.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.5.3",
    "supertest": "^7.2.2",
    "tsx": "^4.19.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.30.1",
    "vitest": "^3.1.2"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
