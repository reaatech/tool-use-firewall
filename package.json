{
  "name": "tool-use-firewall-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Policy enforcement layer between AI agents and MCP servers",
  "type": "module",
  "scripts": {
    "build": "pnpm install && turbo run build",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "clean": "turbo run clean && rm -rf node_modules",
    "dev": "tsx packages/server/src/cli.ts",
    "security:audit": "pnpm audit --audit-level moderate",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && changeset publish"
  },
  "keywords": [
    "mcp",
    "firewall",
    "ai-agent",
    "policy",
    "security",
    "proxy"
  ],
  "author": "Rick Somers <rick@reaatech.com> (https://reaatech.com)",
  "license": "MIT",
  "packageManager": "pnpm@10.22.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reaatech/tool-use-firewall.git"
  },
  "bugs": {
    "url": "https://github.com/reaatech/tool-use-firewall/issues"
  },
  "homepage": "https://github.com/reaatech/tool-use-firewall#readme",
  "pnpm": {
    "overrides": {
      "esbuild": "^0.28.1"
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },

  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.28.1",
    "@vitest/coverage-v8": "4.1.9",
    "tsx": "^4.22.4",
    "turbo": "^2.9.18",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
